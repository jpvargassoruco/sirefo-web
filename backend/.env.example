# Copiar a .env y ajustar segun el entorno.

# mock (desarrollo/pruebas) o soap (produccion real contra ASFI)
SIREFO_MODE=mock

# WSDL real de ASFI (solo modo soap)
SIREFO_WSDL_URL=https://srvservicios.asfi.gov.bo/retencionesDev/ServicioRetencionFondos.svc?wsdl

# Credenciales asignadas por ASFI (rol ServicioRetenciones).
# OBLIGATORIAS incluso en modo mock (el mock rechaza credenciales vacias para
# imitar al servicio real; en mock cualquier valor no vacio sirve).
SIREFO_ASFI_USUARIO=usuario_mock
SIREFO_ASFI_CLAVE=clave_mock

# Codigo de entidad asignado por ASFI (ej. AN, SIN, AJ)
SIREFO_ENTIDAD=GAMW

# Codificacion de los hashes SHA-1 enviados a ASFI: hex, HEX o base64
SIREFO_HASH_ENCODING=hex

# Verificacion TLS del cliente SOAP (modo soap)
SIREFO_TLS_VERIFY=true

# Seguridad JWT
SIREFO_JWT_SECRET=change-me

# Base de datos
SIREFO_DB_URL=sqlite:///./sirefo.db

# Password del usuario semilla "admin"
SIREFO_ADMIN_PASSWORD=admin123
